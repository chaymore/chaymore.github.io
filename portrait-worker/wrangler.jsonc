{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caleb-portrait-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portrait-context",
      "database_id": "4fe51b7a-d4a6-4b2b-9689-3c09bb89abcc"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://calebhaymore.com,https://chaymore.github.io",
    "OPENROUTER_MODEL": "openai/gpt-4o-mini",
    "TTS_MODEL": "microsoft/mai-voice-2-flash",
    "TTS_VOICE": "en-US-Harper:MAI-Voice-2",
    "FISH_TTS_MODEL": "fish-audio/s2.1-pro"
  },
  // Voice clone stays off until caleb-reference.wav exists in this bucket. See docs/VOICE-CLONE.md.
  // Paid Fish model: about 0.7 s faster to first audio than "fish-audio/s2.1-pro-free:free" (Sept 2026 benchmark).
  // Secret placeholder (not a var): FISH_REFERENCE_ID
  // Optional transcript secret: FISH_REFERENCE_TRANSCRIPT
  // Reference clip. A 20–45s recording does not fit in a Worker secret.
  "r2_buckets": [
    { "binding": "VOICE_REFERENCE", "bucket_name": "portrait-voice" }
  ]
}
